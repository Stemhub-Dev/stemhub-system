# Copiar a .env y ajustar. Valores por defecto tomados de
# Stem-Hub-BackEnd/.env.example, stemhub-frontend/.env.example y
# stemhub-microservicio-IA/.env.example.

# --- Postgres / Backend (Stem-Hub-BackEnd) ---
DB_NAME=stemhubdev
DB_USER=stemhub_app
DB_PASSWORD=CAMBIAR_PASSWORD
DB_PORT=5432
APP_PORT=8080

# --- Supabase local (levantado aparte con "npx supabase start" en
# Stem-Hub-BackEnd; no forma parte de este compose) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_BASE_URL=http://kong:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- ML Service (stemhub-microservicio-IA) ---
ML_SERVICE_PORT=8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
QWEN_API_KEY=
QWEN_API_BASE_URL=
QWEN_MODEL=qwen2.5-7b-instruct

# --- MinIO (storage de audio, compartido con Stem-Hub-BackEnd) ---
MINIO_ROOT_USER=stemhub_minio_admin
MINIO_ROOT_PASSWORD=CAMBIAR_PASSWORD
MINIO_ACCESS_KEY=stemhub_minio_admin
MINIO_SECRET_KEY=CAMBIAR_PASSWORD
MINIO_BUCKET=stemhub-audio
MINIO_USE_SSL=false
# Host con el que el navegador resuelve las URLs presignadas de audio (no el
# backend, que sigue usando MINIO_ENDPOINT). Cambiar si accedés al front
# desde otra máquina/host distinto de localhost.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false

# --- Frontend (stemhub-frontend) ---
# URLs accesibles desde el navegador (no desde la red interna de Docker).
VITE_API_BASE_URL=http://localhost:8080
# Supabase Auth local, levantado aparte con "npx supabase start"
# (ver Stem-Hub-BackEnd/supabase/README.md) — no forma parte de este compose.
VITE_GOTRUE_URL=http://127.0.0.1:54321/auth/v1
