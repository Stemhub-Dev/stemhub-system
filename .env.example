# Copiar a .env y ajustar. Valores por defecto tomados de
# Stem-Hub-BackEnd/.env.example y stemhub-frontend/.env.example.

# --- Postgres / Backend (Stem-Hub-BackEnd) ---
DB_NAME=stemhubdev
DB_USER=stemhub_app
DB_PASSWORD=CAMBIAR_PASSWORD
DB_PORT=5432
APP_PORT=8080

# --- Frontend (stemhub-frontend) ---
# URL del backend accesible desde el navegador (no desde la red interna de Docker).
VITE_API_BASE_URL=http://localhost:8080
# GoTrue no forma parte de este orquestador todavia; el login/JWT no
# funcionara hasta que se levante ese servicio por separado.
VITE_GOTRUE_URL=http://localhost:9999
