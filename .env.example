# Copiar a .env y ajustar. Valores por defecto tomados de
# Stem-Hub-BackEnd/.env.example, stemhub-frontend/.env.example y
# stemhub-microservicio-IA/.env.example.

# --- Postgres / Backend (Stem-Hub-BackEnd) ---
DB_NAME=stemhubdev
DB_USER=stemhub_app
DB_PASSWORD=CAMBIAR_PASSWORD
DB_PORT=5432
APP_PORT=8080

# --- Supabase local (levantado aparte con "npx supabase start" en
# Stem-Hub-BackEnd; no forma parte de este compose) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_BASE_URL=http://kong:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP para el mail de invitación a proyecto (enviado directamente por el
# backend Go, no por GoTrue). En dev local, apuntar a Inbucket: descomentar
# "smtp_port = 54325" en Stem-Hub-BackEnd/supabase/config.toml ([local_smtp])
# y dejar SMTP_USER/SMTP_PASSWORD vacíos. En producción, usar Gmail con una
# contraseña de aplicación (mismo proveedor/credencial que auth.email.smtp
# en supabase/config.toml y que el SMTP configurado en Supabase Cloud
# Authentication > SMTP Settings, para no depender del límite de 2
# emails/hora del SMTP demo de Supabase).
#
# El backend corre dentro de Docker, en la misma red que crea
# "npx supabase start", así que apunta al contenedor de Inbucket por su
# nombre y su puerto SMTP INTERNO (1025) — no "127.0.0.1:54325", que es el
# puerto mapeado al host para procesos que corren fuera de Docker (mismo
# motivo por el que SUPABASE_JWKS_BASE_URL usa "kong" en vez de 127.0.0.1).
# Si en algún momento el backend corre nativo (no dockerizado), usar en
# cambio SMTP_HOST=127.0.0.1 y SMTP_PORT=54325.
SMTP_HOST=supabase_inbucket_supabase-stemhub
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=StemHub <no-reply@stemhub.app>
FRONTEND_BASE_URL=http://localhost:5173
INVITACION_DIAS_VENCIMIENTO=7

# --- ML Service (stemhub-microservicio-IA) ---
ML_SERVICE_PORT=8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
QWEN_API_KEY=
QWEN_API_BASE_URL=
QWEN_MODEL=qwen2.5-7b-instruct

# --- MinIO (storage de audio, compartido con Stem-Hub-BackEnd) ---
MINIO_ROOT_USER=stemhub_minio_admin
MINIO_ROOT_PASSWORD=CAMBIAR_PASSWORD
MINIO_ACCESS_KEY=stemhub_minio_admin
MINIO_SECRET_KEY=CAMBIAR_PASSWORD
MINIO_BUCKET=stemhub-audio
MINIO_USE_SSL=false
# Host con el que el navegador resuelve las URLs presignadas de audio (no el
# backend, que sigue usando MINIO_ENDPOINT). Cambiar si accedés al front
# desde otra máquina/host distinto de localhost.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false

# --- Frontend (stemhub-frontend) ---
# URLs accesibles desde el navegador (no desde la red interna de Docker).
VITE_API_BASE_URL=http://localhost:8080
# Supabase Auth local, levantado aparte con "npx supabase start"
# (ver Stem-Hub-BackEnd/supabase/README.md) — no forma parte de este compose.
VITE_GOTRUE_URL=http://127.0.0.1:54321/auth/v1
# anon/public key fija de la Supabase CLI local (mismo valor en cualquier
# instalación, no es secreta — la imprime "npx supabase start").
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
