# Copiar a .env.production y ajustar. Usado por deploy.sh junto con
# docker-compose.yml + docker-compose.prod.yml. A diferencia de .env.example
# (dev), acá NO hay Supabase local ni build de imágenes — todo apunta a
# servicios reales/gestionados y a tags ya publicados por el CI de cada
# subrepo en ghcr.io/stemhub-dev.

# --- Tags de imagen (poblados por el CI de cada subrepo al taggear release,
# ver .github/workflows/publish-image.yml en cada subrepo) ---
BACKEND_TAG=latest
FRONTEND_TAG=latest
ML_SERVICE_TAG=latest
SPLEETER_TAG=latest

# --- Postgres ---
DB_NAME=stemhub
DB_USER=stemhub_app
DB_PASSWORD=CAMBIAR_PASSWORD
DB_PORT=5432
APP_PORT=8080

# --- Supabase Cloud (reemplaza a "npx supabase start") ---
# SUPABASE_URL es la URL del proyecto Cloud (https://<project-ref>.supabase.co),
# el mismo valor que usa el frontend para VITE_GOTRUE_URL. Con Supabase Cloud
# el backend descarga el JWKS de la misma URL pública, así que
# SUPABASE_JWKS_BASE_URL queda vacía (no hace falta el camino alternativo vía
# "kong" que sólo existe con la CLI local).
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_BASE_URL=

# Dominio real del frontend servido en producción.
CORS_ALLOWED_ORIGINS=https://app.stemhub.io
FRONTEND_BASE_URL=https://app.stemhub.io

# --- SMTP real (SendGrid u otro proveedor transaccional) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CAMBIAR_SENDGRID_API_KEY
SMTP_REMITENTE=StemHub <no-reply@stemhub.app>
INVITACION_DIAS_VENCIMIENTO=7

# --- ML Service ---
ML_SERVICE_PORT=8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
QWEN_API_KEY=
QWEN_API_BASE_URL=
QWEN_MODEL=qwen2.5-7b-instruct

# --- MinIO ---
# Punto abierto: en producción real, MinIO necesita quedar accesible con un
# endpoint público estable (dominio + TLS) para que las URLs presignadas
# funcionen fuera de la red interna de Docker, o reemplazarse por un bucket
# S3-compatible gestionado (AWS S3, Backblaze B2, DigitalOcean Spaces, MinIO
# gestionado). Backend y ml-service ya leen el endpoint por variable de
# entorno, así que ese cambio futuro es sólo de este .env, no de código: si
# se migra a un proveedor externo, quitar el servicio "minio" de
# docker-compose.prod.yml y apuntar MINIO_PUBLIC_ENDPOINT/MINIO_ENDPOINT ahí.
MINIO_ROOT_USER=CAMBIAR_USER
MINIO_ROOT_PASSWORD=CAMBIAR_PASSWORD
MINIO_ACCESS_KEY=CAMBIAR_USER
MINIO_SECRET_KEY=CAMBIAR_PASSWORD
MINIO_BUCKET=stemhub-audio
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=storage.stemhub.io
MINIO_PUBLIC_USE_SSL=true

# --- Frontend ---
# Usadas sólo por el CI del subrepo stemhub-frontend (build-args), no por
# este compose — quedan acá documentadas para que ambos lados usen el mismo
# valor. Configurar como GitHub Actions "repository variables" en ese repo.
VITE_API_BASE_URL=https://api.stemhub.io
VITE_GOTRUE_URL=https://TU_PROJECT_REF.supabase.co/auth/v1
