      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (label_replace(label_replace(container_memory_working_set_bytes{name!=\"\"}, \"service\", \"$1\", \"name\", \"(.+)\"), \"service\", \"$1\", \"name\", \"(.+)-[a-z0-9]{24}-[0-9]{8}T[0-9]{6}\"))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
