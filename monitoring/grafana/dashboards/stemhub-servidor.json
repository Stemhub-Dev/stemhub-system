    {
      "id": 7,
      "type": "timeseries",
      "title": "Presión (PSI): tiempo esperando recursos",
      "description": "Fracción del tiempo en que algún proceso estuvo frenado esperando ese recurso. Memoria alta y sostenida = el servidor está usando swap como RAM (lo que lo deja sin responder).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_memory_waiting_seconds_total[$__rate_interval])",
          "legendFormat": "memoria"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_io_waiting_seconds_total[$__rate_interval])",
          "legendFormat": "disco (IO)"
